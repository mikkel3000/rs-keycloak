  "paired": false,
  "scope": "Realm role create, read, list and delete, and user realm role mappings, through the admin API; names and selected fields only.",
  "normalization": "The random realm name and base URL are replaced with {realm} and {base}.",
  "observations": {
    "list/defaults": {
      "status": 200,
      "location": null,
      "empty_body": false,
      "names": [
        "default-roles-{realm}",
        "offline_access",
        "uma_authorization"
      ],
      "item_fields": [
        "clientRole",
        "composite",
        "containerId",
        "description",
        "id",
        "name"
      ]
    },
    "create/success": {
      "status": 201,
      "location": "{base}/admin/realms/{realm}/roles/reader",
      "empty_body": true
    },
    "create/second": {
      "status": 201,
      "location": "{base}/admin/realms/{realm}/roles/writer",
      "empty_body": true
    },
    "create/duplicate": {
      "status": 409,
      "location": null,
      "empty_body": false,
      "body_fields": [
        "errorMessage"
      ],
      "body": {
        "errorMessage": "Role with name reader already exists"
      }
    },
    "create/missing-name": {
      "status": 400,
      "location": null,
      "empty_body": false,
      "body_fields": [
        "error"
      ],
      "body": {
        "error": "role has no name"
      }
    },
    "create/malformed-json": {
      "status": 400,
      "location": null,
      "empty_body": false,
      "body_fields": [
        "error",
        "error_description"
      ],
      "body": {
        "error": "invalid_request",
        "error_description": "Cannot parse the JSON"
      }
    },
    "create/no-token": {
      "status": 401,
      "location": null,
      "empty_body": false,
      "body_fields": [
        "error"
      ],
      "body": {
        "error": "HTTP 401 Unauthorized"
      }
