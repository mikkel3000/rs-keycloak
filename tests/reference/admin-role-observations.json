    "get/success": {
      "status": 200,
      "location": null,
      "empty_body": false,
      "body_fields": [
        "attributes",
        "clientRole",
        "composite",
        "containerId",
        "description",
        "id",
        "name"
      ],
      "body": {
        "name": "reader",
        "description": "Reads things",
        "composite": false,
        "clientRole": false
